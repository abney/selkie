
>>> from selkie.pyx.dct import DCTFormat
>>> fmt = DCTFormat('foo', {'foo'}, foo={'bar'}, bar={'a', 'b'})

>>> from pathlib import Path
>>> tmp = Path('/tmp/foo.dct')
>>> if tmp.exists():
...     tmp.unlink()
...
>>> from selkie.pyx.dct import File
>>> fi = File(tmp, format=fmt)
>>> fi.contents
{}

>>> bar1 = {'a': '10', 'b': '20'}
>>> bar2 = {'a': '30', 'b': '40'}
>>> foo = {'bar.1': bar1, 'bar.2': bar2}
>>> fi.contents = {'foo': foo}
>>> print(fi)
#!selkie file foo
foo
  bar.1
    a 10
    b 20
  bar.2
    a 30
    b 40
<BLANKLINE>
>>> s = fi.export('json')
>>> s[:40]
'{"foo": {"bar.1": {"a": "10", "b": "20"}'

>>> from selkie.data import ex
>>> fn = ex('corp29.cld')

# To force the cld format to be registered
>>> from selkie.corpus import Corpus
>>> from selkie.pyx.dct import File
>>> fi = File(fn)
>>> fi.contents
{'corp.corp29': {'lang.deu': {'name': 'German', 'glot': 'stan1295', 'iso3': 'deu', 'text.1': {'ti': 'Eine kleine Geschichte', 'ty': 'story', 'ch': '2 3'}, 'text.2': {'ti': 'p1', 'ty': 'page', 'sent.1': {'w': 'in einem kleinen Dorf am Fluss wohnte ein Schuster', 'tr': 'in a little village on a river there lived a cobbler'}, 'sent.2': {'w': 'der Schuster war sehr arm', 'tr': 'the cobbler was very poor'}}, 'text.3': {'ti': 'p2', 'ty': 'page', 'sent.3': {'w': 'eines Tages begegnete der Schuster einen Bettler', 'tr': 'one day the cobbler met a beggar', 'times': {'t.0': '1.495800', 't.2': '1.939400', 't.5': '2.783300', 't.7': '3.326900'}}, 'sent.4': {'w': 'Ende', 'tr': 'the end', 'times': {'t.0': '3.688200', 't.1': '3.928300'}}}, 'lexicon': {'form.begegnete': {}, 'form.Bettler': {}, 'form.der': {'c': 'det', 'g': 'the'}, 'form.einen': {'g': 'a(n)'}, 'form.eines': {'g': 'of a(n)'}, 'form.Schuster': {'g': 'cobbler'}, 'form.Tag': {'g': 'day'}, 'form.Tages': {'pp': 'Tag .gen'}, 'form.-gen': {'g': '<genitive>'}}}}}
>>> fi.export('json')
'{"corp.corp29": {"lang.deu": {"name": "German", "glot": "stan1295", "iso3": "deu", "text.1": {"ti": "Eine kleine Geschichte", "ty": "story", "ch": "2 3"}, "text.2": {"ti": "p1", "ty": "page", "sent.1": {"w": "in einem kleinen Dorf am Fluss wohnte ein Schuster", "tr": "in a little village on a river there lived a cobbler"}, "sent.2": {"w": "der Schuster war sehr arm", "tr": "the cobbler was very poor"}}, "text.3": {"ti": "p2", "ty": "page", "sent.3": {"w": "eines Tages begegnete der Schuster einen Bettler", "tr": "one day the cobbler met a beggar", "times": {"t.0": "1.495800", "t.2": "1.939400", "t.5": "2.783300", "t.7": "3.326900"}}, "sent.4": {"w": "Ende", "tr": "the end", "times": {"t.0": "3.688200", "t.1": "3.928300"}}}, "lexicon": {"form.begegnete": {}, "form.Bettler": {}, "form.der": {"c": "det", "g": "the"}, "form.einen": {"g": "a(n)"}, "form.eines": {"g": "of a(n)"}, "form.Schuster": {"g": "cobbler"}, "form.Tag": {"g": "day"}, "form.Tages": {"pp": "Tag .gen"}, "form.-gen": {"g": "<genitive>"}}}}}'

