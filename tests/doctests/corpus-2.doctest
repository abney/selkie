[<Language deu>]

>>> list(reg)
[<Corpus corp28>]
>>> reg.get('corp28')
<Corpus corp28>

>>> corpus = reg.new()
>>> corpus
<Corpus untitled-1>
>>> print(corpus)
#!selkie file cld 28
0
class Root
