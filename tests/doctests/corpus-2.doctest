
>>> from selkie.corpus import Registry
>>> reg = Registry()
>>> from selkie.data import ex
>>> corpus = reg.open(ex('corp29.cld'))
>>> list(corpus.langs)
[<Language deu>]

>>> list(reg)
[<Corpus corp29>]
>>> reg.get('corp29')
<Corpus corp29>

>>> corpus = reg.new()
>>> corpus
<Corpus untitled-1>
>>> print(corpus)
#!selkie file cld29
corp.untitled-1
<BLANKLINE>

>>> corpus.select()
>>> corpus.print_state()
corp:
  <Corpus corp29> 
  <Corpus untitled-1> == selected
    lang:
    rom:
>>> corpus = reg.get('corp29')
>>> corpus.print_state()
corp:
  <Corpus corp29> 
  <Corpus untitled-1> == selected
    lang:
    rom:

>>> deu = corpus.langs[0]
>>> deu
<Language deu>
>>> deu1 = deu.texts[0]
>>> deu1
<Text deu.1>

>>> deu1.select()
>>> deu1.print_state()
corp:
  <Corpus corp29> == selected
    lang:
      <Language deu> == selected
        text:
          <Text deu.1> == selected
            sent:
          <Text deu.2> 
          <Text deu.3> 
    rom:
  <Corpus untitled-1> 
>>> reg.get('untitled-1').select()
>>> reg.print_state()
corp:
  <Corpus corp29> 
  <Corpus untitled-1> == selected
    lang:
    rom:
